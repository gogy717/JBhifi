# Copy to web/.env.local (gitignored) and fill in from the Clerk Dashboard → API keys. Never commit real keys.
# `clerk init --app <app id>` in this folder writes the same file for you.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Our own sign-in pages (app/sign-in, app/sign-up) — also used by proxy.ts when it sends a visitor to sign in.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
