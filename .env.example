# Copy to .env — the API and the tests read these. They match docker-compose.yml (local dev only).
POSTGRES_USER=jbhifi
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=jbhifi
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# The disposable database `pytest` drops and rebuilds on every run. It must not be POSTGRES_DB, and its
# name must end in _test (or _demo). Change it only if you want tests to use a different throwaway database.
POSTGRES_TEST_DB=jbhifi_test

# The least-privilege role the API connects as (created by sql/05_permissions.sql). It can read and write
# the business tables but cannot edit history, delete a payment, or change the schema. Leave these blank to
# run the API as the owner instead.
POSTGRES_APP_USER=jbhifi_app
POSTGRES_APP_PASSWORD=apppassword
