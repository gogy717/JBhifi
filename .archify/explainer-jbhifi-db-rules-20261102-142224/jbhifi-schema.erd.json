  "cards": [
    {
      "dot": "cyan",
      "title": "Composite keys that carry rules",
      "items": [
        "br04: store (store_id, manager_id) -> staff (store_id, staff_id), checked at COMMIT because store and staff point at each other.",
        "br17: customer_order (customer_id, delivery_address_no) -> customer_address: only the customer's own address.",
        "br13: return_line (return_id, order_id) -> return_request: a return line comes from the returned order.",
        "br18 and return_request: (store_id, staff_id) -> staff: only staff of that store act on its stock and returns."
      ]
    },
    {
      "dot": "amber",
      "title": "Not drawn as lines",
      "items": [
        "category.parent_id -> category.category_id is a self-reference: a two-level category tree.",
        "order_status_transition has no foreign key: the BR09 trigger reads it on every status change.",
        "One charge per order is a partial unique index, br20_one_charge_per_order (WHERE kind = 'charge')."
      ]
    },
    {
      "dot": "emerald",
      "title": "Domains and keys",
      "items": [
        "money_aud is NUMERIC(10,2) >= 0 (BR02); email_address is a lower-case address format (BR01).",
        "fulfilment, order_status, au_state and au_postcode are domains with a CHECKed value list or format.",
        "Surrogate keys are INT GENERATED BY DEFAULT AS IDENTITY; weak entities use composite keys."
      ]
    }
  ]
}
