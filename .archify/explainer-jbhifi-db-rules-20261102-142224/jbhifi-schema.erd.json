        "focus": [
          "customer_order",
          "order_line",
          "order_status_history",
          "order_status_transition",
          "customer_address",
          "store"
        ],
        "note": "BR06-BR10, BR17, BR20: a fixed header, immutable lines, status moves read from order_status_transition and logged to history."
      },
      {
        "id": "returns-refunds",
        "label": "Returns and refunds",
        "focus": [
          "return_request",
          "return_line",
          "payment",
          "order_line",
          "customer_order"
        ],
        "note": "BR11-BR14: composite FKs keep return lines and refunds on the same order; triggers cap quantities and amounts."
      },
      {
        "id": "stock",
        "label": "Stock per store",
        "focus": [
          "inventory",
          "stock_adjustment",
          "store",
          "staff",
          "product"
        ],
        "note": "BR03, BR18: inventory is the store x product M:N; each manual change is logged by staff of that store."
      },
      {
        "id": "people",
        "label": "People and sign-in",
        "focus": [
          "customer",
          "user_account",
          "staff",
          "store"
        ],
        "note": "BR04, BR05, BR19: one staff table for the ISA, a deferred manager FK, one sign-in per person."
      },
      {
        "id": "catalogue",
        "label": "Catalogue and pricing",
        "focus": [
          "product",
          "brand",
          "category",
          "product_spec",
          "promotion"
        ],
        "note": "BR15: promotions never overlap and stay below the base price; specs are key-value rows."
      }
    ]
  },
